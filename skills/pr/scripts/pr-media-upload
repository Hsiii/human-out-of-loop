#!/usr/bin/env bash
set -euo pipefail

usage() {
  printf 'Usage: %s [--available] --repo OWNER/REPO --pr NUMBER <image-or-video>\n' "$(basename "$0")" >&2
  exit 2
}

package="${PR_MEDIA_PACKAGE:-sago-media@0.1.0}"
npx_command="${PR_MEDIA_NPX_COMMAND:-npx}"
available=0
repo=
pr_number=
source_path=

while [ "$#" -gt 0 ]; do
  case "$1" in
    --available) available=1; shift ;;
    --repo) [ "$#" -ge 2 ] || usage; repo="$2"; shift 2 ;;
    --pr) [ "$#" -ge 2 ] || usage; pr_number="$2"; shift 2 ;;
    --) shift; [ "$#" -eq 1 ] || usage; source_path="$1"; shift ;;
    -*) usage ;;
    *) [ -z "$source_path" ] || usage; source_path="$1"; shift ;;
  esac
done

command -v "$npx_command" >/dev/null 2>&1 || exit 1

if [ "$available" = 1 ]; then
  [ -z "$repo" ] && [ -z "$pr_number" ] && [ -z "$source_path" ] || usage
  exec "$npx_command" --yes "$package" auth status --quiet
fi

[ -n "$repo" ] && [ -n "$pr_number" ] && [ -n "$source_path" ] || usage
[[ "$repo" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || usage
[[ "$pr_number" =~ ^[1-9][0-9]*$ ]] || usage
source_path="$(realpath "$source_path")"
[ -f "$source_path" ] || usage

exec "$npx_command" --yes "$package" upload "$source_path" --repo "$repo" --pr "$pr_number" --output markdown
