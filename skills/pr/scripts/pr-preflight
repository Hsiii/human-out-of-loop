#!/usr/bin/env bash
set -euo pipefail

branch="$(git branch --show-current)"

if [[ -z "$branch" ]]; then
  echo "PR_PREFLIGHT_BLOCKED reason=detached_head" >&2
  exit 2
fi

if ! git diff --quiet || ! git diff --cached --quiet; then
  echo "PR_PREFLIGHT_BLOCKED reason=tracked_changes branch=$branch" >&2
  exit 3
fi

remote="$(git config "branch.$branch.remote" || true)"
if [[ -z "$remote" || "$remote" == "." ]]; then
  remote="origin"
fi

remote_url="$(git remote get-url "$remote" || true)"
if [[ -z "$remote_url" ]]; then
  echo "PR_PREFLIGHT_BLOCKED reason=missing_remote branch=$branch remote=$remote" >&2
  exit 10
fi

if ! repo_info="$(gh repo view "$remote_url" --json nameWithOwner,defaultBranchRef,viewerPermission --jq '[.nameWithOwner, .defaultBranchRef.name, .viewerPermission] | @tsv')"; then
  echo "PR_PREFLIGHT_BLOCKED reason=unresolved_remote branch=$branch remote=$remote url=$remote_url" >&2
  exit 11
fi
IFS=$'\t' read -r repo default_branch viewer_permission <<< "$repo_info"

case "$viewer_permission" in
  ADMIN | MAINTAIN | WRITE) ;;
  *)
    echo "PR_PREFLIGHT_BLOCKED reason=repository_not_writable repo=$repo remote=$remote permission=$viewer_permission" >&2
    exit 12
    ;;
esac

git fetch "$remote" "$default_branch" >/dev/null
base_ref="refs/remotes/$remote/$default_branch"
base_sha="$(git rev-parse "$base_ref")"
head_sha="$(git rev-parse "$branch")"

if [[ "$branch" == "$default_branch" ]]; then
  echo "PR_PREFLIGHT_BLOCKED reason=default_branch branch=$branch base=$base_sha" >&2
  exit 4
fi

if [[ ! "$branch" =~ ^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)/[a-z0-9]+(-[a-z0-9]+)*$ ]]; then
  echo "PR_PREFLIGHT_BLOCKED reason=invalid_branch_name branch=$branch expected='<type>/<kebab-case-description>'" >&2
  exit 9
fi

pr_counts="$(gh pr list --repo "$repo" --head "$branch" --state all --limit 100 --json state,isDraft --jq '[[.[] | select(.state != "OPEN")], [.[] | select(.state == "OPEN" and (.isDraft | not))], [.[] | select(.state == "OPEN" and .isDraft)]] | map(length) | @tsv')"
IFS=$'\t' read -r spent_count ready_count draft_count <<< "$pr_counts"

if (( spent_count > 0 )); then
  echo "PR_PREFLIGHT_BLOCKED reason=spent_branch branch=$branch completed_prs=$spent_count" >&2
  exit 5
fi

if (( ready_count > 0 )); then
  echo "PR_PREFLIGHT_BLOCKED reason=non_draft_pr branch=$branch open_prs=$ready_count" >&2
  exit 6
fi

if (( draft_count > 1 )); then
  echo "PR_PREFLIGHT_BLOCKED reason=ambiguous_drafts branch=$branch open_drafts=$draft_count" >&2
  exit 7
fi

commit_count="$(git rev-list --count "$base_ref..$head_sha")"
if (( commit_count == 0 )); then
  echo "PR_PREFLIGHT_BLOCKED reason=no_commits branch=$branch base=$base_sha head=$head_sha" >&2
  exit 8
fi

echo "PR_PREFLIGHT_OK repo=$repo remote=$remote base_branch=$default_branch base=$base_sha branch=$branch head=$head_sha commits=$commit_count drafts=$draft_count"
git log --oneline "$base_ref..$head_sha"
