#!/usr/bin/env bash
set -euo pipefail

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
state="$(bash "$root/pr-preflight" | sed -n '1p')"
value() { sed -n "s/.* $1=\([^ ]*\).*/\1/p" <<<"$state"; }
repo="$(value repo)"
remote="$(value remote)"
base_branch="$(value base_branch)"
base="$(value base)"
branch="$(value branch)"
head="$(value head)"
drafts="$(value drafts)"
number="$(gh pr list --repo "$repo" --head "$branch" --state open --json number,isDraft --jq '.[] | select(.isDraft) | .number' | head -1)"

if [[ "${1:-}" == --snapshot ]]; then
  [[ "$drafts" == 0 ]] || gh pr view "$number" --repo "$repo" --json body --template '{{.body}}'
  exit
fi

[[ "$#" == 3 || "$#" == 4 ]] || { echo "Usage: pr-publish BASE HEAD TITLE [SNAPSHOT] < BODY" >&2; exit 2; }
[[ "$base" == "$1" && "$head" == "$2" ]] || { echo "PR_PUBLISH_BLOCKED reason=review_changed" >&2; exit 3; }
title="$3"
snapshot="${4:-}"
title_pattern='^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)(\([^)]+\))?!?: .+'
[[ "$title" =~ $title_pattern ]] || { echo "PR_PUBLISH_BLOCKED reason=invalid_title" >&2; exit 4; }

body="$(mktemp)"
saved="$(mktemp)"
local_commits="$(mktemp)"
remote_commits="$(mktemp)"
trap 'rm -f -- "$body" "$saved" "$local_commits" "$remote_commits"' EXIT
cat >"$body"
[[ -s "$body" ]] || { echo "PR_PUBLISH_BLOCKED reason=empty_body" >&2; exit 5; }
if grep -Eq '(\.codex-pr-media/|file://|!?\[[^]]*\]\(/)' "$body"; then
  echo "PR_PUBLISH_BLOCKED reason=local_media" >&2
  exit 6
fi
before="$(grep -c 'Before:' "$body" || true)"
after="$(grep -c 'After:' "$body" || true)"
(( before == 0 && after == 0 || before > 0 && after > 0 )) || { echo "PR_PUBLISH_BLOCKED reason=unpaired_media" >&2; exit 7; }

git push "$remote" "$head:refs/heads/$branch"
if [[ "$drafts" == 0 ]]; then
  url="$(gh pr create --draft --repo "$repo" --base "$base_branch" --head "$branch" --title "$title" --body-file "$body")"
  number="${url##*/}"
else
  [[ -f "$snapshot" ]] || { echo "PR_PUBLISH_BLOCKED reason=missing_snapshot" >&2; exit 8; }
  gh pr view "$number" --repo "$repo" --json body --template '{{.body}}' >"$saved"
  cmp -s "$snapshot" "$saved" || { echo "PR_PUBLISH_BLOCKED reason=body_changed" >&2; exit 9; }
  gh pr edit "$number" --repo "$repo" --title "$title" --body-file "$body" >/dev/null
  url="$(gh pr view "$number" --repo "$repo" --json url --jq .url)"
fi

gh pr view "$number" --repo "$repo" --json body --template '{{.body}}' >"$saved"
cmp -s "$body" "$saved" || { echo "PR_PUBLISH_FAILED reason=body_mismatch url=$url" >&2; exit 10; }
read -r state draft actual_base actual_branch actual_head cross < <(
  gh pr view "$number" --repo "$repo" --json state,isDraft,baseRefName,headRefName,headRefOid,isCrossRepository \
    --jq '[.state,.isDraft,.baseRefName,.headRefName,.headRefOid,.isCrossRepository] | @tsv'
)
[[ "$state" == OPEN && "$draft" == true && "$actual_base" == "$base_branch" &&
  "$actual_branch" == "$branch" && "$actual_head" == "$head" && "$cross" == false ]] ||
  { echo "PR_PUBLISH_FAILED reason=metadata_mismatch url=$url" >&2; exit 11; }
git rev-list --reverse "$base..$head" >"$local_commits"
gh pr view "$number" --repo "$repo" --json commits --jq '.commits[].oid' >"$remote_commits"
cmp -s "$local_commits" "$remote_commits" || { echo "PR_PUBLISH_FAILED reason=commit_mismatch url=$url" >&2; exit 12; }
printf '%s\n' "$url"
