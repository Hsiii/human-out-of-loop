#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../../.." && pwd)"
uploader="$repo_root/skills/pr/scripts/pr-media-upload"
work_dir="$(mktemp -d)"
trap 'rm -rf -- "$work_dir"' EXIT

fake_npx="$work_dir/npx"
printf '%s\n' '#!/usr/bin/env bash' 'printf "%s\n" "$@" >"$PR_MEDIA_TEST_ARGS"' 'if [[ " $* " == *" auth status --quiet "* ]]; then exit 0; fi' 'printf "![PR preview](https://media.example.test/test.png)\n"' >"$fake_npx"
chmod +x "$fake_npx"

source_file="$work_dir/preview.png"
printf test >"$source_file"
export PR_MEDIA_NPX_COMMAND="$fake_npx"
export PR_MEDIA_TEST_ARGS="$work_dir/args"

"$uploader" --available
grep -Fqx 'sago-media@0.1.0' "$work_dir/args"
grep -Fqx 'status' "$work_dir/args"

output="$("$uploader" --repo Hsiii/example --pr 42 "$source_file")"
[ "$output" = '![PR preview](https://media.example.test/test.png)' ]
grep -Fqx 'upload' "$work_dir/args"
grep -Fqx -- '--output' "$work_dir/args"
grep -Fqx 'markdown' "$work_dir/args"

if "$uploader" --repo invalid --pr 42 "$source_file" >/dev/null 2>&1; then
  printf 'invalid repositories must be rejected\n' >&2
  exit 1
fi

printf 'PR media delegates authentication and uploads to the pinned media CLI\n'
