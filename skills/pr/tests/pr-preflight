#!/usr/bin/env bash
set -euo pipefail

skill_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
preflight="$skill_root/scripts/pr-preflight"
work_dir="$(mktemp -d)"
trap 'rm -rf -- "$work_dir"' EXIT

git init -q "$work_dir/seed"
git -C "$work_dir/seed" config user.email test@example.com
git -C "$work_dir/seed" config user.name Test
printf 'base\n' >"$work_dir/seed/file"
git -C "$work_dir/seed" add file
git -C "$work_dir/seed" commit -qm base
git -C "$work_dir/seed" branch -M main
git clone -q --bare "$work_dir/seed" "$work_dir/fork.git"
git clone -q "$work_dir/fork.git" "$work_dir/work"
git -C "$work_dir/work" config user.email test@example.com
git -C "$work_dir/work" config user.name Test
git -C "$work_dir/work" switch -qc fix/fork-target
printf 'head\n' >>"$work_dir/work/file"
git -C "$work_dir/work" commit -qam head

mkdir "$work_dir/bin"
cat >"$work_dir/bin/gh" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

if [[ "$1 $2" == "repo view" ]]; then
  [[ "$3" == "$EXPECTED_REMOTE_URL" ]]
  printf 'orangesago/fork\tmain\t%s\n' "${TEST_PERMISSION:-ADMIN}"
elif [[ "$1 $2" == "pr list" ]]; then
  [[ " $* " == *" --repo orangesago/fork "* ]]
  printf '0\t0\t0\n'
else
  printf 'Unexpected gh command: %s\n' "$*" >&2
  exit 1
fi
EOF
chmod +x "$work_dir/bin/gh"

remote_url="$(git -C "$work_dir/work" remote get-url origin)"
output="$(
  cd "$work_dir/work"
  PATH="$work_dir/bin:/usr/bin:/bin" EXPECTED_REMOTE_URL="$remote_url" \
    bash "$preflight"
)"
[[ "$output" == PR_PREFLIGHT_OK\ repo=orangesago/fork\ * ]]

if (
  cd "$work_dir/work"
  PATH="$work_dir/bin:/usr/bin:/bin" EXPECTED_REMOTE_URL="$remote_url" \
    TEST_PERMISSION=READ bash "$preflight"
) 2>"$work_dir/read-only-error"; then
  printf 'Preflight accepted a read-only publication repository\n' >&2
  exit 1
fi
grep -Fq \
  'PR_PREFLIGHT_BLOCKED reason=repository_not_writable repo=orangesago/fork' \
  "$work_dir/read-only-error"

printf 'PR preflight pins publication to the writable branch remote\n'
